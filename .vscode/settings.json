{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.tabSize": 2,
  "eslint.codeAction.disableRuleComment": {
    "enable": true,
    "location": "separateLine"
  },
  "eslint.enable": true,
  "files.exclude": {
    "**/*.js": {
      "when": "$(basename).ts"
    },
    "**/*.js.map": true,
    "**/*.vscode": false,
    "**/.DS_Store": true,
    "**/.git/": true,
    "**/.idea/": true,
    "**/node_modules/": true
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "js/ts.preferences.quoteStyle": "single",
  "tslint.enable": false,
  "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "workbench.colorCustomizations": {
    "tab.activeBorder": "#fbe60a",
    "titleBar.activeBackground": "#cfbd03",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#cfbd0399",
    "titleBar.inactiveForeground": "#15202b99",
    "statusBar.background": "#cfbd03",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#9d8f02",
    "activityBar.activeBackground": "#fbe60a",
    "activityBar.activeBorder": "#15202b",
    "activityBar.background": "#fbe60a",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#039d8f",
    "activityBarBadge.foreground": "#e7e7e7",
    "sash.hoverBorder": "#fbe60a",
    "statusBarItem.remoteBackground": "#027e73",
    "statusBarItem.remoteForeground": "#15202b",
    "commandCenter.border": "#15202b99",
    "activityBarTop.activeBackground": "#fbe60a",
    "activityBarTop.activeBorder": "#15202b",
    "activityBarTop.background": "#fbe60a",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "statusBar.debuggingBackground": "#cfbd03",
    "statusBar.debuggingForeground": "#15202b",
    "statusBar.inactiveBackground": "#cfbd03"
  },
  "peacock.color": "#cfbd03",
  "peacock.affectTabActiveBorder": true,
  "peacock.affectActivityBar": true
}
